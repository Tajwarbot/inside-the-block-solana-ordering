RPC_URL=https://api.mainnet-beta.solana.com
# SEND_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_FREE_KEY
# Only for --live. Keypair JSON files live in ./keys (git-ignored), never in the repo.
# Defaults: /keys/payer.json for the same-payer arm; /keys/payer.json + /keys/payer2.json..payer5.json
# for the multi-payer arm. OBP_KEYPAIRS overrides both with a comma list.
# OBP_KEYPAIRS=/keys/payer.json,/keys/payer2.json,/keys/payer3.json,/keys/payer4.json,/keys/payer5.json
OBP_CU_LIMIT=21000
# The global per-cluster spend ledger lives here, shared by all sessions (Docker default: /data).
# OBP_LEDGER_DIR=./data
# Docker-only: session directory suffix and burst count. The entrypoint uses
# OBP_DATA=/data/runs/${OBP_RUN_ID:-dryrun}.
# OBP_RUN_ID=dryrun
# OBP_BURSTS=3
# Run `python -m obp calibrate --sim-payer <any funded pubkey>` and keep ~5% CU headroom.
